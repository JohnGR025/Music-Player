{
  "name": "MusicPlayer",
  "version": "2.1.7",
  "description": "Local Music player",
  "main": "main.js",
  "scripts": {
  "start": "electron .",
  "dist": "electron-builder --win",
  "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.johngr025.musicplayer",
    "productName": "MusicPlayer",
    "files": [
      "**/*",
      "!node_modules/electron-builder/**",
      "!dist/**",
      "!.git/**",
      "!*.md"
    ],
    "win": {
    "icon": "build/icons/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "icon": "build/icons/icon.icns"
    },
    "linux": {
      "icon": "build/icons/png",
      "target": "AppImage"
    }
  },
  "keywords": [],
  "author": "JohnGR025",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "music-metadata": "^11.13.0"
  }
}
